{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thyroid-funnel",
  "account_id": "d531de7791cdc9c2aa990c44d9901610",
  // custom-worker.js wraps the OpenNext build and adds the cron handler.
  "main": "custom-worker.js",
  // The *.workers.dev address is OFF (15-Sep-2026). Meta flagged it under its
  // health-data terms and would have blocked pixel data from it; only www
  // should ever send events. Crons and WORKER_SELF_REFERENCE do not use it.
  // Check a new version on www instead.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "thyroid-funnel"
    }
  ],
  // next/image resizing. Free plan: 5,000 unique transformations a month;
  // past that new sizes error rather than bill.
  "images": {
    "binding": "IMAGES"
  },
  // Formerly vercel.json crons (UTC). Keep in sync with CRON_ROUTES in custom-worker.js.
  // Live from the domain switch on; vercel.json is gone so they never run twice.
  // "*/15 * * * *" resends failed Meta CAPI events from the ledger (/api/cron/meta-retry).
  // "7 * * * *" caches Windsor ad spend in D1 for the admin pages (/api/cron/ads-refresh).
  // Free plan allows 5 cron triggers; the webinar reminders are the fifth, on
  // their own line so they do not share a subrequest budget with meta-retry.
  // "30 2 * * *" also runs /api/cron/journey (stages + nurture) before the digest.
  "triggers": {
    "crons": ["30 2 * * *", "50 23 * * *", "*/15 * * * *", "7 * * * *", "5,20,35,50 * * * *"]
  },
  // Payment + Meta event ledger (lib/ledger.ts; schema in migrations/). Only the
  // worker has this binding: on Vercel, in `next dev` and in tests every ledger
  // call is a no-op. Holds ids, amounts, statuses and hashed user_data only.
  "d1_databases": [
    {
      "binding": "LEDGER",
      "database_name": "thyroid-ledger",
      "database_id": "5ab963c5-270c-474a-9d2c-86733d7bfff1",
      "migrations_dir": "migrations"
    }
  ],
  // Routes, not Custom Domains: the @ and www DNS records stay as they are and
  // the switch happens when they are set to Proxied (orange cloud). Rolling
  // back to Vercel is setting them to DNS only again — no records to recreate.
  // The worker answers the bare domain with a 307 to www (custom-worker.js).
  "routes": [
    { "pattern": "www.swapnilumbarkarfitness.in/*", "zone_name": "swapnilumbarkarfitness.in" },
    { "pattern": "swapnilumbarkarfitness.in/*", "zone_name": "swapnilumbarkarfitness.in" }
  ],
  // Workers Logs: request + console logs kept for days, not Vercel Hobby's one hour.
  "observability": {
    "enabled": true
  }
}
