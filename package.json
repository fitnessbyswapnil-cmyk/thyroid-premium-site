{
  "name": "thyroid-premium-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-typography.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types \"lib/**/*.test.ts\" && node scripts/check-typography.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint:type": "node scripts/check-typography.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@calcom/embed-react": "^1.5.3",
    "@cashfreepayments/cashfree-js": "^1.0.7",
    "framer-motion": "^12.38.0",
    "googleapis": "^172.0.0",
    "next": "^16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.0"
  }
}
