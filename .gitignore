# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare (OpenNext build output, wrangler state, local secrets)
.open-next
.wrangler
.dev.vars*
dist-dry

# typescript
*.tsbuildinfo
next-env.d.ts

# Never ship these from a PUBLIC repo (added 08-Nov-2026)
#
# A `git add -A` in this folder used to stage all four, and git's own
# "nothing added to commit but untracked files present" hint points straight
# at them. On a public repo each one is a different kind of leak:
#
#   add-cal-webhook.sh  carries a live Cal.com apiKey and webhook secret
#   _client_reports/    body measurements for named, real clients
#   _media_export/      34 MB of client before/afters, WhatsApp threads, video
#
# Site assets are NOT in here on purpose: public/transformations/ is tracked
# and is where a composite meant to be served belongs.
add-cal-webhook.sh
_client_reports/
_media_export/
.claude/settings.local.json
